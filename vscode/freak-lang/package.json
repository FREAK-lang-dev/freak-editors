{
  "name": "freak-lang",
  "displayName": "FREAK Language Support",
  "description": "Syntax highlighting, snippets, compiler and Hangar commands, and language server support for the FREAK programming language (.fk files)",
  "version": "0.1.0",
  "publisher": "freak-lang-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FREAK-lang-dev/freak-editors"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:freak"
  ],
  "main": "./extension.js",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "freak",
    "fk",
    "systems programming",
    "compiled",
    "anime"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "freak",
        "aliases": [
          "FREAK",
          "freak"
        ],
        "extensions": [
          ".fk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/freak-file.svg",
          "dark": "./icons/freak-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "freak",
        "scopeName": "source.freak",
        "path": "./syntaxes/freak.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "freak",
        "path": "./snippets/freak.json"
      }
    ],
    "configuration": {
      "title": "FREAK",
      "properties": {
        "freak.compilerPath": {
          "type": "string",
          "default": "freak",
          "description": "Path to the freak compiler used by the Run/Build/Check/Test commands and compiler diagnostics"
        },
        "freak.diagnostics.compiler": {
          "type": "boolean",
          "default": true,
          "description": "Report `freak check` errors in the editor when a file is opened or saved"
        },
        "freak.diagnostics.maverick": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "With the native `freak-lsp` server, also report live diagnostics from the Maverick (V4) compiler on every edit. Maverick is strict V4, so it flags V3-only code such as root statements."
        },
        "freak.build.optimization": {
          "type": "string",
          "enum": [
            "default",
            "O0",
            "O1",
            "O2",
            "O3"
          ],
          "default": "default",
          "markdownDescription": "Optimization level passed to **Run File** and **Build File** (`--O0`..`--O3`, FREAK 0.15.1+). `default` passes nothing, which builds at `--O2`."
        },
        "freak.build.lto": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "thin",
            "full"
          ],
          "default": "default",
          "markdownDescription": "Link-time optimization for **Run File** and **Build File**: `thin` passes `--tlto`, `full` passes `--flto` (FREAK 0.15.1+). `default` passes nothing."
        },
        "freak.diagnosticCast": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "minimal",
            "normal"
          ],
          "default": "default",
          "markdownDescription": "Diagnostic cast for **Run**, **Build** and **Check** (`--diagnostic-cast=...`, FREAK 0.15.1+). When on, the cast comments on your errors after the normal diagnostic. `default` passes nothing (the compiler's default is `off`)."
        },
        "freak.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the FREAK language server (autocomplete, hover, diagnostics)"
        },
        "freak.lsp.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python interpreter for the LSP server (auto-detected if empty)"
        },
        "freak.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to freak_lsp.py (auto-detected if empty)"
        },
        "freak.lsp.server": {
          "type": "string",
          "enum": ["auto", "freak-lsp", "python"],
          "enumDescriptions": [
            "Use the native freak-lsp server when it is on PATH or next to the compiler, else the bundled Python server",
            "Use the native freak-lsp server (falls back to Python with a warning when it is missing)",
            "Always use the bundled Python server"
          ],
          "default": "auto",
          "description": "Which FREAK language server to start"
        },
        "freak.lsp.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command that starts a different FREAK language server over stdio, for example `[\"freak-lsp\"]`. When set, it replaces the bundled Python server and `freak.lsp.pythonPath` and `freak.lsp.serverPath` are ignored."
        }
      }
    },
    "commands": [
      {
        "command": "freak.runFile",
        "title": "Run File",
        "category": "FREAK",
        "icon": "$(play)"
      },
      {
        "command": "freak.buildFile",
        "title": "Build File",
        "category": "FREAK",
        "icon": "$(tools)"
      },
      {
        "command": "freak.checkFile",
        "title": "Check File",
        "category": "FREAK",
        "icon": "$(check)"
      },
      {
        "command": "freak.testProject",
        "title": "Test Project",
        "category": "FREAK",
        "icon": "$(beaker)"
      },
      {
        "command": "freak.hangarInstall",
        "title": "Install Dependencies",
        "category": "Hangar",
        "icon": "$(package)"
      },
      {
        "command": "freak.hangarUpdate",
        "title": "Update Dependencies",
        "category": "Hangar",
        "icon": "$(sync)"
      },
      {
        "command": "freak.hangarAdd",
        "title": "Add Dependency...",
        "category": "Hangar",
        "icon": "$(add)"
      },
      {
        "command": "freak.hangarOutdated",
        "title": "Show Outdated Dependencies",
        "category": "Hangar",
        "icon": "$(versions)"
      },
      {
        "command": "freak.hangarAudit",
        "title": "Audit Dependencies",
        "category": "Hangar",
        "icon": "$(shield)"
      },
      {
        "command": "freak.hangarLogin",
        "title": "Log In to the Registry",
        "category": "Hangar",
        "icon": "$(sign-in)"
      },
      {
        "command": "freak.hangarStatus",
        "title": "Show Registry Account",
        "category": "Hangar",
        "icon": "$(account)"
      },
      {
        "command": "freak.hangarLogout",
        "title": "Log Out of the Registry",
        "category": "Hangar",
        "icon": "$(sign-out)"
      },
      {
        "command": "freak.hangarPublishDryRun",
        "title": "Publish Package (Dry Run)",
        "category": "Hangar",
        "icon": "$(eye)"
      },
      {
        "command": "freak.hangarPublish",
        "title": "Publish Package...",
        "category": "Hangar",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "freak.restartServer",
        "title": "Restart Language Server",
        "category": "FREAK"
      },
      {
        "command": "freak.showCommands",
        "title": "Show Commands",
        "category": "FREAK"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "freak.runFile",
          "when": "resourceLangId == freak",
          "group": "navigation@1"
        },
        {
          "command": "freak.checkFile",
          "when": "resourceLangId == freak",
          "group": "navigation@2"
        },
        {
          "command": "freak.buildFile",
          "when": "resourceLangId == freak",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "freak.runFile",
          "when": "resourceExtname == .fk",
          "group": "freak@1"
        }
      ],
      "commandPalette": [
        {
          "command": "freak.runFile",
          "when": "editorLangId == freak"
        },
        {
          "command": "freak.buildFile",
          "when": "editorLangId == freak"
        },
        {
          "command": "freak.checkFile",
          "when": "editorLangId == freak"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "freak",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The freak subcommand: run, build, check, test, or hangar"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "freak",
        "owner": "freak",
        "source": "freak",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(?:\u001b\\[[0-9;]*m)*(?:[a-z]+ )?(error|warning)(?:\u001b\\[[0-9;]*m)*: (.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*--> (.+):(\\d+):(\\d+)\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ]
  }
}
